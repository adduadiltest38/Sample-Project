# ─────────────────────────────────────────────────────────────
# ChargeFlow demo configuration — nothing here is required.
# ─────────────────────────────────────────────────────────────

# Backend port (the Vite dev server proxies /api to it)
API_PORT=8787

# Python AI service (ai-service/chargeflow_ai.py). `npm run dev` starts it.
# If it isn't running, the backend's TypeScript engine answers instead.
AI_SERVICE_PORT=8790
AI_SERVICE_URL=http://localhost:8790

# ─────────────────────────────────────────────────────────────
# ChargeFlow demo configuration
# Nothing here is required — the demo runs fully offline with
# the deterministic RecommendationEngine when these are empty.
# ─────────────────────────────────────────────────────────────

# Optional: enables richer natural-language answers via OpenRouter.
# The key is only ever read by the backend (never sent to the browser).
OPENROUTER_API_KEY=
# Any OpenRouter model slug, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o-mini
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Backend port (the Vite dev server proxies /api to it)
API_PORT=8787
